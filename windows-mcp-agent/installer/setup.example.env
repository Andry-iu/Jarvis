# Copiare questo file come setup.local.env accanto a INSTALLA.cmd.
# Inserire token/email SOLO nella copia locale; non inviarla in chat o Git.
# UTF-8, una variabile per riga. Nessuna espansione: percorsi e token letterali.
# Virgolette esterne facoltative. Non usare commenti a fine riga.
INSTALL_DIR=D:\Jarvis
DEVICE_NAME=Desktop2
PROJECTS_ROOT=
MCP_PORT=8765
SETUP_NO_PROMPTS=true
SETUP_ALLOW_BROWSER_LOGIN=true
SETUP_REMOTE_MODE=auto
SETUP_NO_TASK=false
SETUP_NO_SHORTCUTS=false
CODEX_EXECUTABLE=

# Token API Cloudflare (non token tunnel, non API key OpenAI).
CLOUDFLARE_API_TOKEN=
# Dominio gia attivo: indicarlo se il token permette piu zone.
CLOUDFLARE_ZONE_NAME=autech-sm.com
CLOUDFLARE_ZONE_ID=
# Vuoto = jarvis-<nome dispositivo>, ad esempio jarvis-desktop2.
CLOUDFLARE_HOST_LABEL=
# Email esatta gia autorizzata/da autorizzare in Cloudflare Access.
CLOUDFLARE_ACCESS_EMAIL=

# Solo SETUP_REMOTE_MODE=manual (lasciare vuoto nella modalita auto).
CLOUDFLARE_HOSTNAME=
CLOUDFLARE_TEAM_DOMAIN=
CLOUDFLARE_APP_AUD=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
